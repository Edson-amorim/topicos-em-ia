<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollPrincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabeçalho Principal com Ícone de Acessibilidade e Inclusão -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/ivIconeApp"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="Ícone do Comanda Falada: símbolo universal da acessibilidade no topo e pessoas com e sem deficiência segurando juntas um cardápio aberto."
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🍽️ Comanda Falada · Passo à Frente"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FACC15"
                    android:contentDescription="Aplicativo Comanda Falada, Passo à Frente. Estabelecimentos para comer e consumir com filtro por Região, Estado, Cidade e Categoria, integração com Google Maps, soma pela IA e pagamento nos bancos." />

                <TextView
                    android:id="@+id/tvSubtitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Locais p/ Comer + Filtros + Maps + Soma IA + Bancos"
                    android:textSize="13sp"
                    android:textColor="#E2E8F0"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Painel de Voz / Status em Tempo Real -->
        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#172554"
            android:padding="12dp"
            android:text="🔊 Filtre por Região, Estado e Cidade, abra no Google Maps ou escolha um Bar abaixo."
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FEF08A"
            android:accessibilityLiveRegion="polite"
            android:layout_marginBottom="14dp" />

        <!-- SEÇÃO 1: FILTROS POR REGIÃO, ESTADO, CIDADE E GOOGLE MAPS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. FILTROS (REGIÃO, ESTADO, CIDADE) E GOOGLE MAPS:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnFiltroRegiao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="🗺️ Filtrar por Região: Todas as Regiões"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1E3A8A"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnFiltroEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="🏳️ Filtrar por Estado (UF): Todos os Estados"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0F766E"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnFiltroCidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="🏙️ Filtrar por Cidade: Todas as Cidades"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#047857"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnFiltroCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="🍽️ Filtrar por Categoria: Todas as Categorias"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7E22CE"
            android:layout_marginBottom="8dp" />

        <!-- Botões de Integração Direta com o Google Maps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnGoogleMapsRota"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="54dp"
                android:text="📍 Rota no Google Maps p/ Este Bar"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#B45309"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnGoogleMapsExplorar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="54dp"
                android:text="🗺️ Ver Bares da Cidade no Maps"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D97706"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnImportarBarDoMaps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="📲 Abrir Cardápio de Bar Vindo do Google Maps"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7C2D12"
            android:contentDescription="Abrir cardápio de qualquer bar aberto ou compartilhado pelo Google Maps"
            android:layout_marginBottom="8dp" />

        <!-- Caixa de Busca para Localizar Qualquer Estabelecimento / Cidade -->
        <EditText
            android:id="@+id/etBuscaQualquerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:hint="Digite qualquer restaurante, padaria, pizzaria, café, museu ou cidade..."
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8"
            android:background="#1E293B"
            android:padding="12dp"
            android:singleLine="true"
            android:inputType="text"
            android:contentDescription="Caixa de texto para localizar qualquer estabelecimento para comer ou visitar com cardápio disponível"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnLocalizarBarTexto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="54dp"
                android:text="🔎 Localizar Local / Cardápio"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0284C7"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnBuscarVozLocal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="54dp"
                android:text="🎤 Localizar por Voz"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6D28D9"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Filtros Acústicos e Mostrar Todos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnFiltroAcustico"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="50dp"
                android:text="🔉 Só Conforto Acústico"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0369A1"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnFiltroTodos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="50dp"
                android:text="🔄 Limpar Filtros"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#334155"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Lista dinâmica de Bares e Restaurantes -->
        <LinearLayout
            android:id="@+id/containerEstabelecimentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <!-- SEÇÃO 2: CARDÁPIO COMPLETO E INTERATIVO DO LOCAL SELECIONADO -->
        <TextView
            android:id="@+id/tvTituloCardapio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. CARDÁPIO COMPLETO DO ESTABELECIMENTO:"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FACC15"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnAbrirCardapioPopUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:text="📖 Abrir Cardápio Completo em Lista Rápida (100% dos Itens)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1D4ED8"
            android:contentDescription="Abrir janela com todos os itens do cardápio completo deste estabelecimento para escolher rapidamente com o TalkBack"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnPedirPorVoz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:text="🎙️ Falar Pedido para a IA Somar na Comanda"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0F766E"
            android:layout_marginBottom="8dp" />

        <!-- Lista dinâmica de Itens do Cardápio -->
        <LinearLayout
            android:id="@+id/containerCardapio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <!-- SEÇÃO 3: SOMA DA COMANDA PELA IA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. SUA COMANDA E SOMA AUTOMÁTICA DA IA:"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#4ADE80"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvResumoComanda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:padding="14dp"
            android:text="Sua comanda está vazia. Toque nos itens do cardápio acima para adicionar."
            android:textSize="15sp"
            android:textColor="#F8FAFC"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnTaxaServico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:text="💁 Deseja adicionar os 10% do garçom? (Atual: Não)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0F766E"
            android:contentDescription="Pergunta: Deseja adicionar os dez por cento de taxa de serviço na soma da comanda? Toque duas vezes para escolher Sim ou Não."
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnOuvirComanda"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:text="🔊 Ouvir Soma"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1D4ED8"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnAlterarTeto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:text="🎯 Teto: R$ 100"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4338CA"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnLimparComanda"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:text="🗑️ Limpar"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#991B1B"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- SEÇÃO 4: BOTÃO PARA PAGAR NOS BANCOS INSTALADOS NO CELULAR -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. PAGAMENTO PIX NOS BANCOS DO SEU CELULAR:"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FACC15"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnPagarBanco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="🏦 COPIAR PIX E ABRIR APP DO BANCO NO CELULAR"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#15803D"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/containerBancosInstalados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="18dp" />

        <!-- SEÇÃO 5: ATALHOS DOS 3 CASOS DE DEMONSTRAÇÃO DA DISCIPLINA (TEC.MD) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5. CASOS DE TESTE DA DISCIPLINA (AI4GOOD):"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnCaso1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Caso 1: Buscar Bar com Conforto Acústico"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#334155"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnCaso2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Caso 2: Pedido Caldinho + Suco (R$ 22,00) e Pix"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#334155"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnCaso3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Caso 3: Testar Ruído de Bar (Onde a IA Erra)"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#334155"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
